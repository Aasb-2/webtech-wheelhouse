<h1>Repairs</h1>

<%= link_to "New repair", new_repair_path, class: "btn btn-primary mb-3" %>

<% if @repairs.any? %>
  <table class="table table-striped">
    <thead>
  <tr>
    <th>Photo</th>
    <th>Repair</th>
    <th>Bike</th>
    <th>Customer</th>
    <th>Status</th>
    <th>Promised</th>
    <th>Diagnosis</th>
  </tr>
</thead>
    <tbody>
      <%= render @repairs %>
    </tbody>
  </table>
<% else %>
  <p>No repairs yet.</p>
<% end %>