<% content_for :title, @mechanic.name %>

<h1><%= @mechanic.name %></h1>

<h2>Assigned Repairs</h2>
<% if @mechanic.repairs.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Repair</th>
        <th>Bike</th>
        <th>Customer</th>
        <th>Status</th>
        <th>Promised</th>
      </tr>
    </thead>
    <tbody>
      <%= render @mechanic.repairs %>
    </tbody>
  </table>
<% else %>
  <p>No repairs currently assigned to this mechanic.</p>
<% end %>

<%= link_to "Back to Mechanics", mechanics_path %>