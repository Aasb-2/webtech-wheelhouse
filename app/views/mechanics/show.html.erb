<% content_for :title, @mechanic.name %>

<h1><%= @mechanic.name %></h1>

<%= link_to "Edit", edit_mechanic_path(@mechanic), class: "btn btn-outline-primary" %>
<%= button_to "Delete", mechanic_path(@mechanic), method: :delete,
      class: "btn btn-danger",
      form: { class: "d-inline", data: { turbo_confirm: "Delete mechanic #{@mechanic.name}?" } } %>

<h2>Assigned Repairs</h2>
<% if @mechanic.repairs.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Repair</th>
        <th>Bike</th>
        <th>Customer</th>
        <th>Status</th>
        <th>Promised</th>
      </tr>
    </thead>
    <tbody>
      <%= render @mechanic.repairs %>
    </tbody>
  </table>
<% else %>
  <p>No repairs currently assigned to this mechanic.</p>
<% end %>

<%= link_to "Back to Mechanics", mechanics_path %>