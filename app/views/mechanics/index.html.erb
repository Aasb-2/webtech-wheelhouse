<h1>Mechanics</h1>
<% if policy(Mechanic).new? %>
  <%= link_to "New mechanic", new_mechanic_path, class: "btn btn-primary mb-3" %>
<% end %>

<% if @mechanics.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Name</th>
      </tr>
    </thead>
    <tbody>
      <% @mechanics.each do |mechanic| %>
        <tr>
          <td><%= link_to mechanic.name, mechanic_path(mechanic) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No mechanics yet.</p>
<% end %>