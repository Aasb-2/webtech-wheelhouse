<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wheelhouse" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light mb-4">
  <div class="container">
    <%= link_to "Wheelhouse", authenticated? ? root_path : service_items_path, class: "navbar-brand" %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <% if authenticated? %>
          <li class="nav-item">
            <%= link_to "Home", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %>
          </li>
        <% end %>
        <li class="nav-item">
          <%= link_to "Services", service_items_path, class: "nav-link #{'active' if current_page?(service_items_path)}" %>
        </li>
        <% if authenticated? %>
          <li class="nav-item">
            <%= link_to "Customers", customers_path, class: "nav-link #{'active' if current_page?(customers_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Bikes", bikes_path, class: "nav-link #{'active' if current_page?(bikes_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Repairs", repairs_path, class: "nav-link #{'active' if current_page?(repairs_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Mechanics", mechanics_path, class: "nav-link #{'active' if current_page?(mechanics_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Visiting the Workshop", visiting_path, class: "nav-link #{'active' if current_page?(visiting_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to "About", about_path, class: "nav-link #{'active' if current_page?(about_path)}" %>
          </li>
        <% end %>
      </ul>

      <ul class="navbar-nav">
        <% if authenticated? %>
          <li class="nav-item d-flex align-items-center me-3">
            <span class="navbar-text">
              Signed in as <strong><%= Current.user.display_name %></strong> (<%= Current.user.role.titleize %>)
            </span>
          </li>
          <li class="nav-item">
            <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-outline-secondary btn-sm",
                  form: { class: "d-inline" } %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Sign in", new_session_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>

<main class="container">
  <% flash.each do |type, message| %>
    <div class="alert alert-<%= type == "alert" ? "danger" : "success" %>" role="alert">
      <%= message %>
    </div>
  <% end %>
  <%= yield %>
</main>