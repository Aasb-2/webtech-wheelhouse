<% content_for :title, "Update your password" %>

<h1>Update your password</h1>

<%= form_with url: password_path(params[:token]), method: :put do |form| %>
  <%= render "shared/error_summary", record: @user %>

  <div class="mb-3">
    <%= form.label :password, "New password", class: "form-label" %>
    <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password",
          maxlength: 72, class: class_names("form-control", "is-invalid": @user.errors[:password].any?) %>
    <% @user.errors.full_messages_for(:password).each do |message| %>
      <div class="invalid-feedback"><%= message %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :password_confirmation, "Confirm new password", class: "form-label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
          maxlength: 72, class: class_names("form-control", "is-invalid": @user.errors[:password_confirmation].any?) %>
    <% @user.errors.full_messages_for(:password_confirmation).each do |message| %>
      <div class="invalid-feedback"><%= message %></div>
    <% end %>
  </div>

  <%= form.submit "Save", class: "btn btn-primary" %>
<% end %>