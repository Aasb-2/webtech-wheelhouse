<% content_for :title, @customer.name %>

<h1><%= @customer.name %></h1>
<p><%= @customer.phone %></p>

<h2>Bikes</h2>
<% if @customer.bikes.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Model</th>
        <th>Serial Number</th>
        <th>Owner</th>
      </tr>
    </thead>
    <tbody>
      <%= render @customer.bikes %>
    </tbody>
  </table>
<% else %>
  <p>No bikes on file for this customer.</p>
<% end %>

<%= link_to "Back to Customers", customers_path %>