<% content_for :title, @customer.name %>

<h1><%= @customer.name %></h1>
<p><%= @customer.phone %></p>
<%= link_to "Edit", edit_customer_path(@customer), class: "btn btn-outline-primary" %>
<%= button_to "Delete", customer_path(@customer), method: :delete,
      class: "btn btn-danger",
      form: { class: "d-inline", data: { turbo_confirm: "Delete customer #{@customer.name}?" } } %>

<h2>Bikes</h2>
<% if @customer.bikes.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Model</th>
        <th>Serial Number</th>
        <th>Owner</th>
      </tr>
    </thead>
    <tbody>
      <%= render @customer.bikes %>
    </tbody>
  </table>
<% else %>
  <p>No bikes on file for this customer.</p>
<% end %>
<%= link_to "New bike for #{@customer.name}", new_bike_path(customer_id: @customer.id), class: "btn btn-outline-primary mb-3" %>

<%= link_to "Back to Customers", customers_path %>