<%= form_with model: customer do |form| %>
  <%= render "shared/error_summary", record: customer %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: class_names("form-control", "is-invalid": customer.errors[:name].any?) %>
    <% customer.errors.full_messages_for(:name).each do |message| %>
      <div class="invalid-feedback"><%= message %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :phone, class: "form-label" %>
    <%= form.telephone_field :phone, class: class_names("form-control", "is-invalid": customer.errors[:phone].any?) %>
    <% customer.errors.full_messages_for(:phone).each do |message| %>
      <div class="invalid-feedback"><%= message %></div>
    <% end %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", customer.persisted? ? customer : customers_path, class: "btn btn-outline-secondary" %>
<% end %>