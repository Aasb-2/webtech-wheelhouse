<h1>Customers</h1>
<%= link_to "New customer", new_customer_path, class: "btn btn-primary mb-3" %>

<% if @customers.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Name</th>
        <th>Phone</th>
      </tr>
    </thead>
    <tbody>
      <% @customers.each do |customer| %>
        <tr>
          <td><%= link_to customer.name, customer_path(customer) %></td>
          <td><%= customer.phone %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No customers yet.</p>
<% end %>