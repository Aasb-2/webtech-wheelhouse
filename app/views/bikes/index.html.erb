<h1>Bikes</h1>
<%= link_to "New bike", new_bike_path, class: "btn btn-primary mb-3" %>

<% if @bikes.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Model</th>
        <th>Serial Number</th>
        <th>Owner</th>
      </tr>
    </thead>
    <tbody>
      <%= render @bikes %>
    </tbody>
  </table>
<% else %>
  <p>No bikes yet.</p>
<% end %>